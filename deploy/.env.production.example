# Copy to deploy/.env.production and fill only in the host/provider secret manager.
HEEL_PUBLIC_ORIGIN=https://YOUR_HEEL_DOMAIN
HEEL_DEVICE_TOKEN_PEPPER_B64=
HEEL_API_KEY_PEPPER=
HEEL_EDGE_AUTH_SECRET_B64=
HEEL_SIGNUP_MAX_PER_IP=3
HEEL_SIGNUP_MAX_GLOBAL=50
HEEL_CLOUDFLARE_TUNNEL_TOKEN=
# Use a reviewed immutable image reference such as cloudflare/cloudflared@sha256:<digest>.
HEEL_CLOUDFLARED_IMAGE=
