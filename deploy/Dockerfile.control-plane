# syntax=docker/dockerfile:1.7
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=random

RUN groupadd --system --gid 10001 heel \
    && useradd --system --uid 10001 --gid heel --home-dir /nonexistent --shell /usr/sbin/nologin heel \
    && install -d -o heel -g heel -m 0700 /var/lib/heel

WORKDIR /app
COPY --chown=root:root heel /app/heel
COPY --chown=root:root LICENSE-COMMERCIAL.md /app/LICENSE-COMMERCIAL.md
RUN pip install --no-cache-dir --only-binary=:all: cryptography==45.0.7 \
    && pip download --no-cache-dir --only-binary=:all: --no-deps -d /tmp/dns dnspython==2.8.0 \
    && echo '01d9bbc4a2d76bf0db7c1f729812ded6d912bd318d3b1cf81d30c0f845dbf3af  /tmp/dns/dnspython-2.8.0-py3-none-any.whl' | sha256sum -c - \
    && pip install --no-cache-dir --no-index --find-links=/tmp/dns dnspython==2.8.0 \
    && rm -rf /tmp/dns

USER heel
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import http.client; c=http.client.HTTPConnection('127.0.0.1',8080,timeout=3); c.request('GET','/v1/readyz'); r=c.getresponse(); r.read(); raise SystemExit(0 if r.status == 200 else 1)"]

ENTRYPOINT ["python", "-m", "heel.saas.server"]
