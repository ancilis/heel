{
  "openapi": "3.1.0",
  "info": {
    "title": "Arceo Local SaaS Demo",
    "version": "0.1.0",
    "description": "A local, canary-only SaaS demo surface for Arceo imported-model rehearsal."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8789",
      "description": "Optional local-only demo server; the ProductModel path does not call it."
    }
  ],
  "paths": {
    "/signup/trial": {
      "post": {
        "summary": "Create a trial workspace using email-only eligibility",
        "x-arceo-kind": "signup",
        "x-arceo-category": "identity_account",
        "x-arceo-weakness": "trial eligibility email-only",
        "responses": {
          "202": {
            "description": "Canary trial accepted"
          }
        }
      }
    },
    "/team/invites": {
      "post": {
        "summary": "Invite a canary teammate",
        "x-arceo-kind": "invite",
        "x-arceo-category": "identity_account",
        "responses": {
          "202": {
            "description": "Canary invite queued"
          }
        }
      }
    },
    "/team/seats": {
      "get": {
        "summary": "Read canary seat pool",
        "x-arceo-kind": "seat",
        "x-arceo-category": "license_entitlement",
        "responses": {
          "200": {
            "description": "Canary seat metadata"
          }
        }
      }
    },
    "/api/usage/monthly": {
      "get": {
        "summary": "Read the monthly usage meter",
        "x-arceo-kind": "meter",
        "x-arceo-category": "license_entitlement",
        "x-arceo-weakness": "client-controlled reset window",
        "responses": {
          "200": {
            "description": "Canary usage total"
          }
        }
      }
    },
    "/api/ai/usage": {
      "get": {
        "summary": "Read the AI-token meter",
        "x-arceo-kind": "meter",
        "x-arceo-category": "license_entitlement",
        "responses": {
          "200": {
            "description": "Canary AI-token usage"
          }
        }
      }
    },
    "/billing/coupons/apply": {
      "post": {
        "summary": "Apply a stackable canary coupon",
        "x-arceo-kind": "promotion",
        "x-arceo-category": "license_entitlement",
        "x-arceo-weakness": "coupon stackable without redemption cap",
        "responses": {
          "200": {
            "description": "Canary coupon accepted"
          }
        }
      }
    },
    "/api/export/bulk-records": {
      "post": {
        "summary": "Bulk export canary tenant records",
        "x-arceo-kind": "export",
        "x-arceo-category": "data_harvesting",
        "x-arceo-weakness": "missing entitlement or quota",
        "responses": {
          "202": {
            "description": "Canary export queued"
          }
        }
      }
    },
    "/api/records/{id}": {
      "get": {
        "summary": "Read one canary tenant record",
        "x-arceo-kind": "record",
        "x-arceo-category": "compliance_boundary",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canary record metadata"
          }
        }
      }
    },
    "/oauth/apps/workspace-sync": {
      "post": {
        "summary": "Install the workspace sync OAuth app",
        "x-arceo-kind": "oauth_app",
        "x-arceo-category": "integration_extensibility",
        "x-arceo-weakness": "OAuth scope=all",
        "responses": {
          "201": {
            "description": "Canary app registered"
          }
        }
      }
    },
    "/webhooks/records/changed": {
      "post": {
        "summary": "Receive a canary records-changed webhook",
        "x-arceo-kind": "integration",
        "x-arceo-category": "integration_extensibility",
        "responses": {
          "204": {
            "description": "Canary webhook accepted"
          }
        }
      }
    },
    "/admin/support/impersonate": {
      "post": {
        "summary": "Support action for a canary account",
        "x-arceo-kind": "admin_action",
        "x-arceo-category": "compliance_boundary",
        "x-arceo-weakness": "audit event missing for admin action",
        "responses": {
          "202": {
            "description": "Canary support action accepted"
          }
        }
      }
    },
    "/agent/tools/export-all-records": {
      "post": {
        "summary": "Agent tool that exports canary records",
        "x-arceo-kind": "agent_tool",
        "x-arceo-category": "agent_mcp_surface",
        "x-arceo-weakness": "granted_scope wider than intended",
        "responses": {
          "202": {
            "description": "Canary agent action queued"
          }
        }
      }
    },
    "/agent/tools/draft-ai-reports": {
      "post": {
        "summary": "Agent tool with unbounded AI-token work",
        "x-arceo-kind": "agent_tool",
        "x-arceo-category": "agent_mcp_surface",
        "x-arceo-weakness": "AI-token tool unbounded",
        "responses": {
          "202": {
            "description": "Canary report drafted"
          }
        }
      }
    },
    "/mcp/workspace-records/manifest": {
      "get": {
        "summary": "Connector-like manifest for workspace records",
        "x-arceo-kind": "mcp_connector",
        "x-arceo-category": "agent_mcp_surface",
        "responses": {
          "200": {
            "description": "Canary manifest metadata"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DemoOAuth": {
        "type": "oauth2",
        "description": "Metadata-only OAuth shape for the canary demo.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://127.0.0.1:8789/oauth/authorize",
            "tokenUrl": "http://127.0.0.1:8789/oauth/exchange",
            "scopes": {
              "workspace.all": "Broad canary workspace scope"
            }
          }
        }
      }
    }
  }
}
