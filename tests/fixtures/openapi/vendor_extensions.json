{
  "openapi": "3.1.0",
  "info": {
    "title": "Extension Demo",
    "version": "1.0"
  },
  "paths": {
    "/api/export/invoices": {
      "get": {
        "tags": ["Finance"],
        "operationId": "exportInvoices",
        "x-heel-plan": "enterprise",
        "x-heel-tenant-scope": "tenant",
        "x-heel-data-class": "canary_invoices",
        "x-heel-control": ["entitlement_check", "rate_limit"]
      }
    },
    "/billing/usage": {
      "get": {
        "tags": ["Billing"],
        "operationId": "usageMeter",
        "x-heel-meter": "invoice_exports"
      }
    },
    "/agent/tools/export": {
      "post": {
        "tags": ["Agent"],
        "operationId": "agentExport",
        "x-heel-agent-tool": {
          "tool": "export_invoices",
          "intended_scope": "tenant",
          "granted_scope": "tenant"
        },
        "x-heel-tenant-scope": "tenant"
      }
    }
  }
}
